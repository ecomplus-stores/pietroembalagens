<!doctype html>
<html lang="<%= _.lang.replace('_', '-') %>" dir="ltr">

<head>
  <%- await include('@/head') %>
</head>

<body id="page-404">
  <%- await include('@/layout/menu') %>

  <main role="main" id="main">
    <%- await include('@/layout/header') %>

    <div class="container py-5">
      <article id="fallback-404" class="text-center py-4">
        <h1 class="h3 mb-3">Ops, esta página não está mais aqui</h1>
        <p class="text-muted mb-4">
          O produto pode ter mudado de endereço ou saído de linha. Busque pelo nome ou pela medida:
        </p>
        <form action="/search" method="get" class="d-flex justify-content-center mb-4" role="search">
          <input class="form-control mr-2" style="max-width: 360px" type="search" name="term" placeholder="Ex.: caixa para 4 doces" aria-label="Buscar produtos" required>
          <button class="btn btn-primary" type="submit">Buscar</button>
        </form>
        <p>
          <a class="btn btn-outline-primary m-1" href="/caixas-tema-natal">Caixas de Natal</a>
          <a class="btn btn-outline-primary m-1" href="/caixas-embalagens-para-doces-e-brigadeiro">Caixas para doces</a>
          <a class="btn btn-link m-1" href="/">Página inicial</a>
        </p>
      </article>
    </div>

    <%- await include('@/layout/footer') %>
  </main>

  <%- await include('@/json') %>
  <%- await include('@/scripts') %>
</body>

</html>
