<%_ /* Quadros personalizados (docs/QUADROS-PERSONALIZADOS.md): o servidor só imprime o contêiner; o JS (personalized-boxes/index.js) monta os quadros no navegador. */ _%>
<noscript><style>.pe-boxes{display:none}</style></noscript>
<section class="pe-boxes" aria-label="Produtos em destaque">
